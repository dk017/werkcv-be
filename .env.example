# ─────────────────────────────────────────────────────────
# Database (Belgian app uses its own database on the shared Postgres server)
# ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:changeme@werkcv-db-1:5432/werkcv_be
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=werkcv_be

# Host app port for the BE stack (proxied by nginx)
APP_PORT=3003

# ─────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://werkcv.be

# ─────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=replace-with-random-64-char-hex-string
AUTH_FROM_EMAIL=contact@werkcv.be

# ─────────────────────────────────────────────────────────
# Email / contact routing
# ─────────────────────────────────────────────────────────
CONTACT_TO_EMAIL=contact@werkcv.be
B2B_LEADS_TO=contact@werkcv.be

# ─────────────────────────────────────────────────────────
# Email (SMTP for login codes and contact mail)
# ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here

# ─────────────────────────────────────────────────────────
# AI (OpenAI — for CV parser, ATS rewrite, cover letter)
# ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ─────────────────────────────────────────────────────────
# Payments
# ─────────────────────────────────────────────────────────
PAYMENT_PROVIDER=dodo
DODO_API_KEY=
DODO_PRODUCT_ID=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=live_mode

POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production
POLAR_PRODUCT_ID_CV_DOWNLOAD=
POLAR_PRICE_ID_CV_DOWNLOAD=
POLAR_PRODUCT_ID_PROFILE_PHOTO=
POLAR_PRODUCT_ID_CV_PROFILE_BUNDLE=
POLAR_PRICE_ID_CV_PROFILE_BUNDLE=
POLAR_PRODUCT_ID_ATS_REWRITE=
POLAR_PRODUCT_ID_COVER_LETTER=
POLAR_PRODUCT_ID_LOCALIZATION=

# ─────────────────────────────────────────────────────────
# Google / analytics operator scripts
# ─────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GSC_SITE_URL=https://werkcv.be/
GA4_PROPERTY_ID=

# ─────────────────────────────────────────────────────────
# Feature flags
# ─────────────────────────────────────────────────────────
PAYMENT_ENABLED=true
